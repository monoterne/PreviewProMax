{
  "name": "preview-pro-max",
  "version": "0.3.2",
  "private": true,
  "description": "Desktop PDF viewer for Linux, macOS and Windows",
  "scripts": {
    "icons": "bun scripts/generate-icons.ts",
    "icons:mac": "bun scripts/compile-icon.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "bunx --bun --no-install vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "dist:linux": "tauri build --bundles deb,rpm",
    "dist:mac": "tauri build --bundles app",
    "dist:win": "tauri build --bundles nsis",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:ui": "playwright test",
    "test:native": "bun scripts/test-native.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
